{
  "name": "resourcehive-presentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "slidev slides.md --port 3030",
    "build": "slidev build slides.md",
    "preview": "node scripts/preview.mjs",
    "export": "slidev export slides.md --output output/resourcehive-technical-evaluation.pdf --timeout 60000 --wait 1000",
    "export:png": "slidev export slides.md --format png --output output/slides --timeout 60000 --wait 1000",
    "check": "node scripts/check-deck.mjs"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@iconify-json/carbon": "^1.2.28",
    "@slidev/cli": "53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/types": "53.0.0",
    "playwright-chromium": "^1.63.0"
  }
}
